# Server Configuration
PORT=5000

# Database Configuration (PostgreSQL)
# Sử dụng khi chạy trong Docker Compose:
DATABASE_URL=postgresql://postgres:postgrespassword@postgres_db:5432/hrm_db
# Sử dụng khi chạy local máy thật (ngoài Docker):
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/hrm_db

# Security & Authentication
JWT_SECRET=hrm_secret_jwt_key_2026_super_secure_random
JWT_EXPIRES_IN=7d

# Email Service (Nodemailer gửi OTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="HRM System <your_email@gmail.com>"
